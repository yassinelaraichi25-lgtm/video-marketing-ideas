// 6. PLANIFICATEUR DE CONTENU (CALENDRIER)
// ============================================

export interface ContentSlot {
  date: Date;
  ideaId: string;
  platform: VideoCampaign["platform"];
  status: "planned" | "recorded" | "edited" | "published";
  notes?: string;
}

export class ContentPlanner {
  private slots: ContentSlot[];

  constructor() {
    this.slots = [];
  }

  addSlot(slot: Omit<ContentSlot, "status">): ContentSlot {
    const newSlot: ContentSlot = {
      ...slot,
      status: "planned",
    };
    this.slots.push(newSlot);
    return newSlot;
  }

  updateSlotStatus(date: Date, status: ContentSlot["status"]): boolean {
    const slot = this.slots.find(s => s.date.getTime() === date.getTime());
    if (!slot) return false;
    slot.status = status;
    return true;
  }

  getUpcomingSlots(limit: number = 10): ContentSlot[] {
    const now = new Date();
    return this.slots
      .filter(slot => slot.date >= now && slot.status !== "published")
      .sort((a, b) => a.date.getTime() - b.date.getTime())
      .slice(0, limit);
  }

  getPublishedSlots(): ContentSlot[] {
    return this.slots.filter(slot => slot.status === "published");
  }

  generateWeeklyPlan(startDate: Date, ideaIds: string[]): ContentSlot[] {
    const weekSlots: ContentSlot[] = [];
    const platforms: VideoCampaign["platform"][] = [
      "tiktok",
      "instagram",
      "youtube",
      "linkedin",
    ];

    for (let i = 0; i < 7; i++) {
      const currentDate = new Date(startDate);
      currentDate.setDate(startDate.getDate() + i);
      const ideaId = ideaIds[i % ideaIds.length];
      const platform = platforms[i % platforms.length];

      weekSlots.push({
        date: currentDate,
        ideaId,
        platform,
        status: "planned",
      });
    }
    return weekSlots;
  }
}

