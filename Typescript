export type VideoFormat = "short" | "long" | "hybrid" | "live";
export type VideoGoal = 
  | "awareness" 
  | "education" 
  | "conversion" 
  | "loyalty" 
  | "virality";
export type VideoIndustry =
  | "ecommerce"
  | "restaurant"
  | "saas"
  | "fitness"
  | "b2b"
  | "education"
  | "beauty"
  | "realestate"
  | "other";
export type VideoStatus = "draft" | "ready" | "published" | "archived";
export type Difficulty = "easy" | "medium" | "advanced";

export interface VideoIdea {
  id: string;
  title: string;
  description: string;
  format: VideoFormat;
  goals: VideoGoal[];
  industries: VideoIndustry[];
  durationSeconds: number;
  difficulty: Difficulty;
  scriptTemplate?: string;
  exampleUrl?: string;
  tags: string[];
  createdAt: Date;
  status: VideoStatus;
  hasBeenProduced: boolean;
  performanceScore?: number; // 0-100
}

export interface VideoProductionChecklist {
  preProduction: string[];
  production: string[];
  postProduction: string[];
  distribution: string[];
}

export interface VideoAnalytics {
  views: number;
  likes: number;
  shares: number;
  saves: number;
  comments: number;
  completionRate: number; // 0-100
  ctr?: number; // click-through rate
}

export interface VideoCampaign {
  id: string;
  ideaId: string;
  title: string;
  publishedDate: Date;
  platform: "tiktok" | "instagram" | "youtube" | "linkedin" | "facebook" | "website";
  url: string;
  analytics: VideoAnalytics;
  notes: string;
}

