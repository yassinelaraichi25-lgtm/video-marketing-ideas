// ============================================
// 4. SERVICE DE GESTION DES IDÉES VIDÉO
// ============================================

export class VideoMarketingLibrary {
  private ideas: VideoIdea[];
  private campaigns: VideoCampaign[];

  constructor(initialIdeas: VideoIdea[] = []) {
    this.ideas = [...initialIdeas];
    this.campaigns = [];
  }

  // Ajouter une nouvelle idée
  addIdea(idea: Omit<VideoIdea, "id" | "createdAt">): VideoIdea {
    const newIdea: VideoIdea = {
      ...idea,
      id: `vid-${Date.now()}-${Math.random().toString(36).substr(2, 6)}`,
      createdAt: new Date(),
      status: "draft",
      hasBeenProduced: false,
    };
    this.ideas.push(newIdea);
    return newIdea;
  }

  // Récupérer toutes les idées
  getAllIdeas(): VideoIdea[] {
    return [...this.ideas];
  }

  // Filtrer par objectif
  filterByGoal(goal: VideoGoal): VideoIdea[] {
    return this.ideas.filter(idea => idea.goals.includes(goal));
  }

  // Filtrer par secteur
  filterByIndustry(industry: VideoIndustry): VideoIdea[] {
    return this.ideas.filter(idea => idea.industries.includes(industry));
  }

  // Filtrer par format
  filterByFormat(format: VideoFormat): VideoIdea[] {
    return this.ideas.filter(idea => idea.format === format);
  }

  // Filtrer par statut
  filterByStatus(status: VideoStatus): VideoIdea[] {
    return this.ideas.filter(idea => idea.status === status);
  }

  // Recherche par mots-clés (titre, description, tags)
  search(keyword: string): VideoIdea[] {
    const lowerKeyword = keyword.toLowerCase();
    return this.ideas.filter(
      idea =>
        idea.title.toLowerCase().includes(lowerKeyword) ||
        idea.description.toLowerCase().includes(lowerKeyword) ||
        idea.tags.some(tag => tag.toLowerCase().includes(lowerKeyword))
    );
  }

  // Obtenir une idée aléatoire (pour inspiration)
  getRandomIdea(filters?: {
    goals?: VideoGoal[];
    industries?: VideoIndustry[];
    difficulty?: Difficulty;
  }): VideoIdea | null {
    let filtered = [...this.ideas];
    if (filters?.goals && filters.goals.length > 0) {
      filtered = filtered.filter(idea =>
        filters.goals!.some(g => idea.goals.includes(g))
      );
    }
    if (filters?.industries && filters.industries.length > 0) {
      filtered = filtered.filter(idea =>
        filters.industries!.some(ind => idea.industries.includes(ind))
      );
    }
    if (filters?.difficulty) {
      filtered = filtered.filter(idea => idea.difficulty === filters.difficulty);
    }
    if (filtered.length === 0) return null;
    const randomIndex = Math.floor(Math.random() * filtered.length);
    return filtered[randomIndex];
  }

  // Marquer une idée comme produite
  markAsProduced(id: string, performanceScore?: number): boolean {
    const idea = this.ideas.find(i => i.id === id);
    if (!idea) return false;
    idea.hasBeenProduced = true;
    idea.status = "published";
    if (performanceScore !== undefined) {
      idea.performanceScore = Math.min(100, Math.max(0, performanceScore));
    }
    return true;
  }

  // Mettre à jour le statut
  updateStatus(id: string, status: VideoStatus): boolean {
    const idea = this.ideas.find(i => i.id === id);
    if (!idea) return false;
    idea.status = status;
    return true;
  }

  // Supprimer une idée
  deleteIdea(id: string): boolean {
    const index = this.ideas.findIndex(i => i.id === id);
    if (index === -1) return false;
    this.ideas.splice(index, 1);
    return true;
  }

  // Obtenir les statistiques de la bibliothèque
  getStats() {
    const total = this.ideas.length;
    const produced = this.ideas.filter(i => i.hasBeenProduced).length;
    const byGoal: Record<VideoGoal, number> = {
      awareness: 0,
      education: 0,
      conversion: 0,
      loyalty: 0,
      virality: 0,
    };
    const byFormat: Record<VideoFormat, number> = {
      short: 0,
      long: 0,
      hybrid: 0,
      live: 0,
    };
    const byDifficulty: Record<Difficulty, number> = {
      easy: 0,
      medium: 0,
      advanced: 0,
    };

    for (const idea of this.ideas) {
      for (const goal of idea.goals) {
        byGoal[goal]++;
      }
      byFormat[idea.format]++;
      byDifficulty[idea.difficulty]++;
    }

    const avgPerformance = this.ideas
      .filter(i => i.performanceScore !== undefined)
      .reduce((sum, i) => sum + (i.performanceScore || 0), 0) / 
      (this.ideas.filter(i => i.performanceScore !== undefined).length || 1);

    return {
      total,
      produced,
      productionRate: total > 0 ? (produced / total) * 100 : 0,
      byGoal,
      byFormat,
      byDifficulty,
      averagePerformanceScore: Math.round(avgPerformance),
    };
  }

  // Exporter la collection en JSON
  exportToJSON(): string {
    return JSON.stringify(
      {
        ideas: this.ideas,
        campaigns: this.campaigns,
        exportedAt: new Date().toISOString(),
      },
      null,
      2
    );
  }

  // Importer depuis JSON
  importFromJSON(json: string): void {
    try {
      const data = JSON.parse(json);
      if (data.ideas) this.ideas = data.ideas;
      if (data.campaigns) this.campaigns = data.campaigns;
    } catch (error) {
      console.error("Erreur d'import JSON", error);
    }
  }
}

// ============================================
// 5. GESTIONNAIRE DE CAMPAGNES VIDÉO
// ============================================

export class VideoCampaignManager {
  private campaigns: VideoCampaign[];

  constructor(initialCampaigns: VideoCampaign[] = []) {
    this.campaigns = [...initialCampaigns];
  }

  addCampaign(campaign: Omit<VideoCampaign, "id">): VideoCampaign {
    const newCampaign: VideoCampaign = {
      ...campaign,
      id: `camp-${Date.now()}-${Math.random().toString(36).substr(2, 6)}`,
    };
    this.campaigns.push(newCampaign);
    return newCampaign;
  }

  getAllCampaigns(): VideoCampaign[] {
    return [...this.campaigns];
  }

  getCampaignsByIdea(ideaId: string): VideoCampaign[] {
    return this.campaigns.filter(c => c.ideaId === ideaId);
  }

  getBestPerformingCampaign(limit: number = 5): VideoCampaign[] {
    return [...this.campaigns]
      .sort((a, b) => (b.analytics.views || 0) - (a.analytics.views || 0))
      .slice(0, limit);
  }

  getTotalViews(): number {
    return this.campaigns.reduce((sum, c) => sum + (c.analytics.views || 0), 0);
  }

  getAverageEngagementRate(): number {
    if (this.campaigns.length === 0) return 0;
    const totalEngagement = this.campaigns.reduce(
      (sum, c) => sum + (c.analytics.likes + c.analytics.shares + c.analytics.comments),
      0
    );
    const totalViews = this.getTotalViews();
    return totalViews > 0 ? (totalEngagement / totalViews) * 100 : 0;
  }
}

