// Suggérer des idées basées sur les performances passées
export function suggestImprovements(
  library: VideoMarketingLibrary,
  campaignManager: VideoCampaignManager
): string[] {
  const suggestions: string[] = [];
  const stats = library.getStats();

  if (stats.productionRate < 30) {
    suggestions.push("🎬 Produis plus de vidéos : seulement " + stats.productionRate.toFixed(0) + "% de tes idées sont réalisées.");
  }

  const avgPerf = stats.averagePerformanceScore;
  if (avgPerf < 70) {
    suggestions.push("📈 Améliore la qualité : score moyen de " + avgPerf + "%. Travaille sur l'accroche et le storytelling.");
  }

  const topGoal = Object.entries(stats.byGoal).sort((a, b) => b[1] - a[1])[0];
  if (topGoal) {
    suggestions.push(`🎯 Ta catégorie dominante est "${topGoal[0]}" avec ${topGoal[1]} idées. Diversifie !`);
  }

  const totalViews = campaignManager.getTotalViews();
  if (totalViews < 10000) {
    suggestions.push("📢 Augmente la distribution : partage tes vidéos sur plus de plateformes.");
  }

  return suggestions;
}

// Générer un prompt pour ChatGPT / IA (aide au script)
export function generateScriptPrompt(idea: VideoIdea): string {
  return `
    Génère un script vidéo pour :
    Titre : ${idea.title}
    Description : ${idea.description}
    Format : ${idea.format} (${idea.durationSeconds} secondes)
    Objectifs : ${idea.goals.join(", ")}
    Tags : ${idea.tags.join(", ")}
    
    Structure recommandée :
    1. Hook (0-5s)
    2. Problème (5-15s)
    3. Solution (15-45s)
    4. Preuve sociale (45-55s)
    5. Call to action (55-60s)
  `;
}

